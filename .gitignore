### macOS ###
.DS_Store
.AppleDouble
.LSOverride

# macOS Icon filenames end in a carriage return (not arbitrary characters).
Icon[[:cntrl:]]

._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
*.icloud

### Vim ###
[._]*.s[a-v][a-z]
!*.svg
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
Session.vim
Sessionx.vim
.netrwhist
tags
# Vim's tags file is ignored, but source directories named tags are not.
!**/tags/
[._]*.un~

